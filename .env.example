# DecryptMe environment variables
# Copy to `.env.local` for local development (and/or set in Vercel Project Settings).
# Never commit real secrets. Only NEXT_PUBLIC_* values are exposed to the browser.

# --- Browser / Supabase Auth (client-side) ---
# Required for Google sign-in, email verification, and password reset flows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=  # optional fallback if not using a publishable key

# --- Database (PostgreSQL / Supabase) ---
# Preferred: full connection string. If set, DB_HOST/PORT/USER/PASSWORD/NAME are ignored.
# For serverless deployments prefer the Supabase connection pooler/transaction URL.
DATABASE_URL=
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=postgres
# DB_SSL=true
# DB_POOL_MAX=5

# --- App auth (JWT, used by /api/auth and protected API routes) ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Supabase server-side (Storage + admin auth operations) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # alternative name accepted by the server
SUPABASE_BUCKET=Files
SUPABASE_SIGNED_URL_TTL=3600

# --- Optional: auth rate limiting ---
# AUTH_RATE_WINDOW_MS=900000
# AUTH_RATE_MAX=10

# --- Standalone API server only (npm run server), not used on Vercel ---
# PORT=3001